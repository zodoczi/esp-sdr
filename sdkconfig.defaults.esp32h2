CONFIG_IDF_TARGET="esp32h2"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_96=y
# CONFIG_PM_ENABLE is not set
# Leave enough non-modem SRAM for static data and task stacks.
# CONFIG_ESP_PHY_IRAM_OPT is not set

CONFIG_ESP_SDR_UART_ENABLED=y
CONFIG_ESP_SDR_UART_BAUD=2000000
CONFIG_ESP_SDR_UART_TX_PIN=24
CONFIG_ESP_SDR_UART_RX_PIN=23

# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
